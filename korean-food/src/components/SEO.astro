---
import {
  GOOGLE_SITE_VERIFICATION,
  OG_IMAGE,
  OG_LOCALE,
  localeUrl,
  ogImageUrl,
  type Locale,
} from '../lib/site';
import { availableLocales, resolveXDefault } from '../lib/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** 소셜 카드 이미지의 대체 텍스트. 히어로 이미지의 alt 를 그대로 쓴다. */
  imageAlt: string;
}

const { locale, title, description, imageAlt } = Astro.props;

const ogImage = ogImageUrl(Astro.site);

const canonical = localeUrl(Astro.site, locale);

// SPEC.md §4 원칙 5 — canonical 은 항상 self.
// 언어 간 canonical 교차는 해당 언어 버전을 색인에서 삭제시킨다.
//
// hreflang 은 자기 자신을 포함한 전 목록을 넣는다. 상호 참조가 하나라도
// 빠지면 세트 전체가 무효화되므로, 모든 로케일 페이지가 같은 목록을 내보내야 한다.
// 목록을 콘텐츠에서 도출하기 때문에 언어별로 갈라질 수 없다.
const available = await availableLocales();
const xDefault = resolveXDefault(available);
---

<meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{available.map((l) => <link rel="alternate" hreflang={l} href={localeUrl(Astro.site, l)} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={localeUrl(Astro.site, xDefault)} />}

<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
{
  available
    .filter((l) => l !== locale)
    .map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)
}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(OG_IMAGE.width)} />
<meta property="og:image:height" content={String(OG_IMAGE.height)} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
